# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection (Leave empty or unreachable to auto-fallback to in-memory MongoDB for local dev)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/htech_wholesale?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=htech_karad_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials (Optional locally — falls back to local disk / data-URI if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Browser Push Notifications (generate one VAPID key pair and keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@htechcomputer.com

# Initial Seed Admin Credentials
ADMIN_EMAIL=admin@htechcomputer.com
ADMIN_PASSWORD=Htech@Admin2026
ADMIN_NAME=H-Tech Admin
